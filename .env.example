# ==========================================================================
# Cyber Security Threat Intelligence Platform — environment configuration
# Copy to `.env` and fill in real values. NEVER commit the real .env file.
# ==========================================================================

# --- Application ---
APP_ENV=development                 # development | staging | production
APP_DEBUG=true
APP_NAME="Threat Intel Platform"
API_V1_PREFIX=/api/v1

# --- Security ---
# 32-byte urlsafe base64 key used to encrypt provider API keys at rest.
# Generate with:  python -m app.scripts.gen_keys
# To rotate: put the NEW key first and keep the old one after it, comma
# separated — the first key encrypts, the rest only decrypt, so existing
# ciphertext keeps working until it has been re-encrypted.
#   MASTER_ENCRYPTION_KEY=<new key>,<previous key>
MASTER_ENCRYPTION_KEY=
# HS256 signing secret for JWTs (>= 32 chars random).
JWT_SECRET_KEY=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# --- Collector safety ---
# When false, collectors/enrichers never make outbound network calls and serve
# bundled sample intelligence instead. This is the safe, offline-first default.
ENABLE_LIVE_COLLECTORS=false
# Role handed to accounts created through /auth/register: viewer | analyst |
# admin. Production refuses to start if open registration hands out anything
# but "viewer". Administrators are created with:
#   python -m app.scripts.create_admin --email you@example.com
REGISTRATION_DEFAULT_ROLE=analyst
# Comma-separated hosts the SSRF guard is allowed to reach for user-supplied
# URL fetches (leave empty to allow any public host; private ranges are always
# blocked regardless).
OUTBOUND_ALLOWED_HOSTS=

# --- Provider API keys (only used when ENABLE_LIVE_COLLECTORS=true) ---
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
SHODAN_API_KEY=
GREYNOISE_API_KEY=

# --- Database / cache ---
DATABASE_URL=postgresql+asyncpg://tip:change-me@localhost:5432/threatintel
REDIS_URL=redis://localhost:6379/0

# Used by docker-compose to provision the database and cache. Neither service
# is published to the host, but pick real values anyway — compose refuses to
# start without them, on purpose.
POSTGRES_USER=tip
POSTGRES_PASSWORD=
POSTGRES_DB=threatintel
REDIS_PASSWORD=

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS / rate limiting ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_PER_MINUTE=120
# Networks whose X-Forwarded-For header may be trusted (comma-separated CIDRs).
# Leave EMPTY unless the API sits behind a reverse proxy you control: trusting
# the header from anyone lets a client forge its own source IP and walk around
# the per-IP rate limiter. Use the proxy's network, e.g. 172.16.0.0/12 for the
# default Docker bridge.
TRUSTED_PROXY_CIDRS=
# Serve /docs, /redoc and /openapi.json. Handy while developing; the app forces
# them off whenever APP_ENV=production, so an attacker never gets a map of the
# API in a deployed environment regardless of what is set here.
EXPOSE_API_DOCS=true
